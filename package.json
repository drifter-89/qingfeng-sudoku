{
  "name": "qingfeng-sudoku",
  "private": true,
  "version": "1.0.0",
  "description": "一个简约清新的离线数独桌面游戏",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "local.qingfeng.sudoku",
    "productName": "清风数独",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release-final"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Qingfeng-Sudoku-${version}-Portable.${ext}"
    }
  }
}
